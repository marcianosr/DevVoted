{
	"name": "devvoted",
	"version": "1.3.0",
	"description": "DevVoted - A developer quiz game with roguelike mechanics",
	"engines": {
		"node": ">=24"
	},
	"keywords": [
		"quiz",
		"game",
		"developer",
		"roguelike",
		"trivia",
		"frontend",
		"backend",
		"whimsical"
	],
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npx tsc --noEmit",
		"start": "vite start",
		"test": "vitest run",
		"release": "tsx scripts/release.ts",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:sonar": "vitest run --coverage",
		"lint": "oxlint src/ && npm run lint:arch",
		"lint:fix": "oxlint src/ --fix",
		"format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
		"sonar:scan": "node sonar-scanner.cjs",
		"sonar:start": "docker compose up -d",
		"sonar:stop": "docker compose down",
		"sonar:full": "npm run test:sonar && npm run sonar:scan",
		"sonar:dev": "npm run sonar:scan",
		"db:seed": "tsx src/database/seed.ts",
		"db:reset": "tsx src/database/reset.ts",
		"db:push": "npx drizzle-kit push",
		"db:generate": "npx drizzle-kit generate",
		"db:migrate": "npx drizzle-kit migrate",
		"db:refresh": "npm run db:reset && npm run db:generate && npm run db:push && npm run db:seed",
		"export:firebase": "node scripts/export-polls.js",
		"prepare": "husky",
		"test-category-weights": "tsx scripts/test-weights.ts",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"lint:arch": "depcruise src --config .dependency-cruiser.cjs"
	},
	"author": "marciano_schildmeijer@live.nl",
	"license": "ISC",
	"dependencies": {
		"@fontsource/fira-code": "^5.2.7",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"@sentry/react": "^10.63.0",
		"@supabase/ssr": "^0.12.0",
		"@supabase/supabase-js": "^2.110.0",
		"@tanstack/react-form": "^1.33.0",
		"@tanstack/react-query": "^5.101.2",
		"@tanstack/react-router": "^1.141.2",
		"@tanstack/react-router-devtools": "^1.167.0",
		"@tanstack/react-start": "^1.168.27",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"deepmerge": "^4.3.1",
		"firebase-admin": "^14.1.0",
		"nitro": "^3.0.260610-beta",
		"postgres": "^3.4.9",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-markdown": "^10.1.0",
		"rehype-highlight": "^7.0.2",
		"resend": "^6.16.0",
		"type-fest": "^5.7.0"
	},
	"devDependencies": {
		"@storybook/addon-themes": "^10.4.6",
		"@storybook/react": "^10.4.5",
		"@storybook/react-vite": "^10.4.6",
		"@tailwindcss/vite": "^4.3.2",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/coverage-v8": "^4.0.15",
		"autoprefixer": "^10.5.2",
		"dependency-cruiser": "^18.1.0",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"husky": "^9.1.7",
		"jest-sonar-reporter": "^2.0.0",
		"jsdom": "^29.1.1",
		"keep-a-changelog": "^3.0.5",
		"lint-staged": "^17.0.8",
		"oxlint": "^1.72.0",
		"postcss": "^8.5.16",
		"prettier": "^3.9.4",
		"sonarqube-scanner": "^4.3.8",
		"storybook": "^10.4.6",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.22.5",
		"typescript": "^6.0.3",
		"vite": "^8.1.3",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.0.15"
	},
	"lint-staged": {
		"src/**/*.{ts,tsx}": [
			"oxlint --fix",
			"prettier --write"
		],
		"*.{json,md}": [
			"prettier --write"
		]
	}
}
