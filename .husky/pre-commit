

# Run lint-staged for formatting and linting
npx lint-staged

# Run type checking on all files
echo "Running type checks..."
npx tsc --noEmit || {
  echo "❌ Type check failed. Please fix type errors before committing."
  exit 1
}

# Run tests for changed files
echo "Running tests for changed files..."
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | grep -E '\.spec\.(ts|tsx)$' || true)

if [ -n "$CHANGED_FILES" ]; then
  npm test -- --run $CHANGED_FILES || {
    echo "❌ Tests failed for changed files. Please fix before committing."
    exit 1
  }
else
  echo "No test files changed, running all tests..."
  npm test -- --run || {
    echo "❌ Tests failed. Please fix before committing."
    exit 1
  }
fi

echo "✅ All pre-commit checks passed!"
